---
import Base from "@/layouts/Base.astro";
import { markdownify } from "@/lib/utils/textConverter";
import { getEntryBySlug } from "astro:content";
const entry = await getEntryBySlug("pages", "404");
const { Content } = await entry.render();
---

<Base title={entry.data.title}>
  <!-- Old addresses: the site lived under /website, and IONOS parked the domain on /defaultsite -->
  <script is:inline>
    (function () {
      var path = location.pathname;
      var target = null;
      if (path === "/defaultsite" || path.indexOf("/defaultsite/") === 0) target = "/";
      else if (path === "/website" || path.indexOf("/website/") === 0) target = path.slice("/website".length) || "/";
      if (target) location.replace(target + location.search + location.hash);
    })();
  </script>
  <section class="section">
    <div class="container">
      <div class="flex h-[40vh] items-center justify-center">
        <div class="text-center">
          <h1 class="mb-4" set:html={markdownify(entry.data.title)} />
          <Content />
        </div>
      </div>
    </div>
  </section>
</Base>
