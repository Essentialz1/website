---
import { Image } from "astro:assets";
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import Cta from "@/layouts/components/Cta.astro";
import { markdownify } from "@/lib/utils/textConverter";
import { getEntryBySlug } from "astro:content";

const homepage = await getEntryBySlug("homepage", "index");
const { banner, download, feature, services, workflow, call_to_action } =
  homepage.data;
const stores = Object.values(config.stores);
---

<Base>
  <!-- banner -->
  <section class="section pb-[50px]">
    <div class="container">
      <div class="row text-center">
        <div class="mx-auto lg:col-10">
          <h1 class="font-primary font-bold">{banner?.title}</h1>
          {
            banner?.content && (
              <p class="mt-4" set:html={markdownify(banner.content)} />
            )
          }

          {
            banner?.button?.enable && (
              <a class="btn btn-primary mt-4" href={banner.button.link}>
                {banner.button.label}
              </a>
            )
          }

          <div id="download" class="mt-8 scroll-mt-28">
            {
              banner?.cta && (
                <a
                  class="btn btn-primary store-primary"
                  href="#download"
                  data-store-link
                  data-umami-event-placement="hero"
                  data-hide-sticky
                >
                  {banner.cta}
                </a>
              )
            }
            <div class="store-badges flex flex-wrap items-center justify-center gap-4">
              {
                stores.map((store) => (
                  <a
                    href={store.link}
                    target="_blank"
                    rel="noopener"
                    data-umami-event={store.event}
                    data-umami-event-placement="hero"
                  >
                    <img
                      class="h-[48px] w-auto"
                      src={store.badge}
                      width={store.badge_width}
                      height={48}
                      alt={store.alt}
                      loading="eager"
                    />
                  </a>
                ))
              }
              <div class="hidden items-center gap-3 text-left md:flex">
                <img src="/website/images/qr-download.svg" width="72" height="72" alt="QR code pour télécharger Skoolz" />
                <p class="text-sm font-bold leading-tight text-dark">
                  Ou scannez avec<br />votre téléphone
                </p>
              </div>
            </div>
            {
              banner?.reassurance && (
                <ul class="reassurance">
                  {banner.reassurance.map((item: string) => (
                    <li>
                      <svg viewBox="0 0 20 20" aria-hidden="true">
                        <path d="M7.6 13.4 4.2 10l-1.4 1.4 4.8 4.8L17.2 6.6l-1.4-1.4z" />
                      </svg>
                      {item}
                    </li>
                  ))}
                </ul>
              )
            }
          </div>

          {
            banner?.apk?.enable && (
              <p class="mt-4">
                <a class="cta-link text-primary" href={banner.apk.link} download>
                  {banner.apk.label}
                </a>
                <span class="mt-1 block text-sm text-slate-500">
                  {banner.apk.note}
                </span>
              </p>
            )
          }

          {
            banner?.video && (
              <video
                class="mx-auto mt-12 w-[340px] max-w-full rounded-[28px] shadow-lg"
                src={banner.video}
                poster={banner.poster}
                autoplay
                muted
                loop
                playsinline
                controls
                aria-label="Skoolz en jeu : les 4 façons de jouer, un duel contre un Gardien et la remise d'un Sceau"
              />
            )
          }

          {
            !banner?.video && banner?.image && (
              <Image
                class="mx-auto mt-12"
                src={banner?.image}
                width={750}
                height={485}
                alt="Les modes de jeu Duel et Solo sur l'écran d'accueil de Skoolz"
              />
            )
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="section bg-theme-light">
    <div class="container">
      <div class="text-center">
        <h2 set:html={markdownify(feature?.title)} />
      </div>
      <div class="mt-8 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          feature?.features.map((item: any) => (
            <div class="feature-card rounded-xl bg-white p-5 pb-8 text-center">
              {item.icon && (
                <img
                  class="mx-auto"
                  alt=""
                  src={item.icon}
                  width={30}
                  height={30}
                />
              )}
              <div class="mt-4">
                <p class="h5" set:html={markdownify(item!.name)} />
                <p class="mt-3">{item.content}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Services -->
  {
    services!.map((service: any, index: number) => {
      const isOdd = index % 2 > 0;
      return (
        <section class={`section ${isOdd && "bg-theme-light"}`}>
          <div class="container">
            <div class="items-center gap-8 md:grid md:grid-cols-2">
              <div class={`service-carousel ${!isOdd && "md:order-2"}`}>
                {service!.images!.length > 1 ? (
                  <div class="swiper">
                    <div class="swiper-wrapper">
                      {service!.images?.map((image: any) => (
                        <div class="swiper-slide">
                          <Image
                            class="mx-auto"
                            src={image.src}
                            width={300}
                            height={650}
                            alt={image.alt}
                          />
                        </div>
                      ))}
                    </div>
                    <div class="pagination" />
                  </div>
                ) : (
                  <Image
                    class="mx-auto"
                    src={service!.images![0].src}
                    width={300}
                    height={650}
                    alt={service!.images![0].alt}
                  />
                )}
              </div>

              {/* Content */}
              <div
                class={`service-content mt-5 md:mt-0 ${!isOdd && "md:order-1"}`}
              >
                <h2 class="font-bold leading-[40px]">{service?.title}</h2>
                <p class="mt-4 mb-2">{service?.content}</p>
                {service?.button?.enable && (
                  <a
                    href={service?.button.link}
                    class="cta-link inline-flex items-center text-primary"
                  >
                    {service?.button.label}
                    <img
                      class="ml-1"
                      src="/website/website/images/arrow-right.svg"
                      width={18}
                      height={14}
                      alt="arrow"
                    />
                  </a>
                )}
              </div>
            </div>
          </div>
        </section>
      );
    })
  }

  <script>
    import { Swiper } from "swiper";
    import "swiper/css";
    import "swiper/css/pagination";
    import { Autoplay, Pagination } from "swiper/modules";

    // Show the download bar only while no other download button is on screen.
    document.addEventListener("astro:page-load", () => {
      const bar = document.querySelector("[data-sticky-download]");
      if (!bar) return;
      const visible = new Set<Element>();
      const targets = document.querySelectorAll("[data-hide-sticky]");
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((e) =>
          e.isIntersecting ? visible.add(e.target) : visible.delete(e.target),
        );
        bar.classList.toggle("is-visible", visible.size === 0);
      });
      targets.forEach((t) => observer.observe(t));
    });

    // astro:page-load event is fired when the page is loaded
    document.addEventListener("astro:page-load", () => {
      // One Swiper per carousel, each with its own bullets.
      document.querySelectorAll(".service-carousel").forEach((carousel) => {
        const swiper = carousel.querySelector(".swiper");
        if (!swiper) return;
        new Swiper(swiper as HTMLElement, {
          modules: [Pagination, Autoplay],
          autoplay: {
            delay: 3000,
          },
          pagination: {
            type: "bullets",
            el: carousel.querySelector(".pagination") as HTMLElement,
            clickable: true,
          },
        });
      });
    });
  </script>
  <!-- ./End service -->

  <!-- Workflow -->
   <!-- 
  <section class="section pb-0">
    <div class="mb-8 text-center">
      <h2
        class="mx-auto max-w-[400px] font-bold leading-[44px]"
        set:html={workflow?.title}
      />
      <p class="mt-3" set:html={workflow?.description} />
    </div>
    <Image
      src={workflow!.image}
      alt="workflow image"
      width={1920}
      height={414}
    />
  </section>
-->
  <!-- Download -->
  {
    download && (
      <section class="download-band">
        <div class="container text-center">
          <h2 class="text-white">{download.title}</h2>
          {download.content && <p class="mx-auto mt-4 max-w-[560px] text-white/80">{download.content}</p>}
          <a
            class="btn btn-primary store-primary mt-8"
            href="#download"
            data-store-link
            data-umami-event-placement="download"
            data-hide-sticky
          >
            {download.cta}
          </a>
          <div class="store-badges mt-8 flex flex-wrap items-center justify-center gap-4">
            {
              stores.map((store) => (
                <a
                  href={store.link}
                  target="_blank"
                  rel="noopener"
                  data-umami-event={store.event}
                  data-umami-event-placement="download"
                >
                  <img
                    class="h-[48px] w-auto"
                    src={store.badge}
                    width={store.badge_width}
                    height={48}
                    alt={store.alt}
                    loading="lazy"
                  />
                </a>
              ))
            }
          </div>
        </div>
      </section>
    )
  }

  <!-- Call to Action -->
  <Cta cta={call_to_action} />

  <!-- Phones only: download bar once the hero button is out of view -->
  <div class="sticky-download" data-sticky-download>
    <img src="/website/images/favicon-skoolz.png" width="44" height="44" alt="" />
    <p class="flex-1 leading-tight">
      <span class="block font-bold text-dark">Skoolz</span>
      <span class="text-sm">Gratuit sur <span data-store-name></span></span>
    </p>
    <a
      class="btn btn-primary px-5 py-3"
      href="#download"
      data-store-link
      data-umami-event-placement="sticky"
    >
      Télécharger
    </a>
  </div>
</Base>
