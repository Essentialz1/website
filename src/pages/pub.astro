---
import Base from "@/layouts/Base.astro";

// Ad review page: not in the menu, not indexed.
// Bumped with each new cut: the files keep their names, so browsers would replay a cached one.
const VERSION = "cdc8d956";
const ads = [
  {
    title: "Collégiens – TikTok",
    videos: [
      { file: "skoolz_ad_college_tiktok_quiz.mp4", label: "TikTok (9:16) · musique quiz", width: 340 },
      { file: "skoolz_ad_college_tiktok_boss.mp4", label: "TikTok (9:16) · musique boss", width: 340 },
    ],
  },
  {
    title: "Parents – Instagram / Facebook",
    videos: [
      { file: "skoolz_ad_parents_9x16_quiz.mp4", label: "Reels / Stories (9:16) · musique quiz", width: 340 },
      { file: "skoolz_ad_parents_9x16_boss.mp4", label: "Reels / Stories (9:16) · musique boss", width: 340 },
      { file: "skoolz_ad_parents_4x5_quiz.mp4", label: "Fil Insta / Facebook (4:5) · musique quiz", width: 420 },
      { file: "skoolz_ad_parents_4x5_boss.mp4", label: "Fil Insta / Facebook (4:5) · musique boss", width: 420 },
    ],
  },
];
---

<Base title="Pub Skoolz" noindex={true}>
  <section class="section">
    <div class="container text-center">
      <h1 class="h2">Pubs Skoolz</h1>
      <p class="mt-4">Activez le son avec le bouton du lecteur.</p>
      {
        ads.map((ad) => (
          <>
            <h2 class="h3 mt-16">{ad.title}</h2>
            <div class="mt-8 grid gap-10 md:grid-cols-2">
              {ad.videos.map((video) => (
                <figure>
                  <video
                    class="mx-auto max-w-full rounded-[20px] shadow-lg"
                    style={`width:${video.width}px`}
                    src={`/videos/pub/${video.file}?v=${VERSION}`}
                    controls
                    playsinline
                    preload="metadata"
                  />
                  <figcaption class="mt-3">
                    {video.label} ·{" "}
                    <a class="text-primary" href={`/videos/pub/${video.file}`} download>
                      télécharger
                    </a>
                  </figcaption>
                </figure>
              ))}
            </div>
          </>
        ))
      }
    </div>
  </section>
</Base>
